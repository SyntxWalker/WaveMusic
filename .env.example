# Discord Bot Credentials (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_client_id_here

# Default prefix (e.g. ! or +)
DEFAULT_PREFIX=!

# Web server port (Render, Koyeb, and Hugging Face automatically set PORT)
PORT=3000

# Theme accent color
EMBED_COLOR=0x8B5CF6
